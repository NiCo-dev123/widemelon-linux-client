if(NOT DEFINED ENV{TRIMUI_TSPS_SDK})
    message(FATAL_ERROR "Set TRIMUI_TSPS_SDK to the extracted Trimui Smart Pro S SDK directory")
endif()

set(TRIMUI_TSPS_SDK "$ENV{TRIMUI_TSPS_SDK}")
set(TRIMUI_TSPS_HOST "${TRIMUI_TSPS_SDK}/host")

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT "${TRIMUI_TSPS_HOST}/aarch64-buildroot-linux-gnu/sysroot")
set(CMAKE_C_COMPILER "${TRIMUI_TSPS_HOST}/bin/aarch64-none-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${TRIMUI_TSPS_HOST}/bin/aarch64-none-linux-gnu-g++")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
